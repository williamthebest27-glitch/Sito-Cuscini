# Copia questo file in ".env.local" e compila i valori.
# .env.local NON va committato (contiene segreti).

# ============================================================
# Amazon MCF (Multi-Channel Fulfillment) — SP-API
# ============================================================
# App SP-API registrata in Seller Central → Developer Central.
# Ottieni client id/secret dall'app e il refresh token autorizzando l'app
# sul tuo account venditore (Login with Amazon).
AMAZON_MCF_CLIENT_ID=
AMAZON_MCF_CLIENT_SECRET=
AMAZON_MCF_REFRESH_TOKEN=

# Regione SP-API: na | eu | fe   (Italia/Europa = eu)
AMAZON_MCF_REGION=eu

# Marketplace ID (Italia = APJ6JRA9NG5V4; Germania = A1PA6795UKMFR9; ecc.)
AMAZON_MCF_MARKETPLACE_ID=APJ6JRA9NG5V4

# Opzionale: mappa SKU-catalogo → seller-SKU Amazon (JSON su una riga).
# Serve solo se gli SKU del sito NON coincidono con quelli su Amazon.
# AMAZON_MCF_SKU_MAP={"B0FR6HG72B":"MSKU-ONDA-BAMBOO"}

# ============================================================
# Pagamento (opzionale)
# ============================================================
# Con le sole credenziali MCF sopra, il pagamento è gestito dal provider
# "manuale" (conferma simulata, nessun addebito) e MCF parte subito dopo.
# Per incassare davvero, imposta un gateway reale: l'evasione MCF scatterà
# automaticamente solo a pagamento confermato.
# STRIPE_SECRET_KEY=sk_live_...

# ============================================================
# WooCommerce — pagina /collezione (opzionale)
# ============================================================
# URL del tuo store WooCommerce; l'admin resta il wp-admin di WordPress.
# WC_STORE_URL=https://tuo-store.com
